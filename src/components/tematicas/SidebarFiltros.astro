---
// src/components/astro/SidebarFiltros.astro
export interface Props {
  categorias: Array<{ id: string; label: string; count: number }>;
  formatos: Array<{ id: string; label: string; count: number }>;
}

const { categorias, formatos } = Astro.props;
---

<aside class="w-full lg:w-64 shrink-0 bg-white rounded-3xl border border-pink-100 shadow-sm overflow-hidden font-['Quicksand'] h-max lg:sticky top-6 z-20">
  <!-- Encabezado convertido en Botón para interactividad en móvil -->
  <button
    id="btn-toggle-filtros"
    class="w-full bg-[#e6206b] text-white font-extrabold text-sm flex items-center justify-between px-5 py-4 shadow-sm lg:cursor-default focus:outline-none"
  >
    <div class="flex items-center gap-2 mx-auto lg:mx-0">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2.5"
        stroke="currentColor"
        class="w-4 h-4"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M10.5 6h9.75M10.5 6a1.5 1.5 0 1 1-3 0m3 0a1.5 1.5 0 1 0-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 0 1-3 0m3 0a1.5 1.5 0 0 0-3 0m-9.75 0h9.75"
        />
      </svg>
      Filtrar resultados
    </div>
    <!-- Flecha que solo se muestra en móviles -->
    <svg
      id="arrow-filtros"
      class="w-4 h-4 lg:hidden transition-transform duration-300"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2.5"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <!-- Contenedor Deslizable (Acordeón) 
       Empieza cerrado en móvil (grid-rows-[0fr]) y abierto en PC (lg:grid-rows-[1fr]) -->
  <div
    id="content-filtros"
    class="grid grid-rows-[0fr] lg:grid-rows-[1fr] transition-[grid-template-rows] duration-300 ease-in-out"
  >
    <div class="overflow-hidden">
      <div class="p-4 sm:p-5">
        <!-- Sección: Categoría -->
        <div class="mb-6">
          <h3 class="flex items-center justify-between w-full text-left font-bold text-[#5e2154] text-sm mb-4">
            Categoría / Tipo de producto
          </h3>
          <div class="space-y-3">
            <!-- Opcion 'Todos' -->
            <label class="flex items-center gap-3 cursor-pointer group">
              <input
                type="checkbox"
                value="todos"
                data-group="categoria"
                checked
                class="filter-checkbox sr-only peer"
              />
              <!-- Cuadrado visual del Checkbox -->
              <div class="w-4 h-4 rounded-sm border-2 border-pink-200 bg-white peer-checked:bg-[#ff4b8b] peer-checked:border-[#ff4b8b] flex items-center justify-center transition-all">
                <svg
                  class="w-3 h-3 text-white opacity-0 peer-checked:opacity-100 transition-opacity"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="3.5"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </div>
              <span class="text-[13px] font-medium text-gray-600 peer-checked:text-[#ff4b8b] peer-checked:font-bold transition-colors">
                Todos
              </span>
            </label>

            {categorias.map((cat) => (
              <label class="flex items-center gap-3 cursor-pointer group">
                <input
                  type="checkbox"
                  value={cat.id}
                  data-group="categoria"
                  class="filter-checkbox sr-only peer"
                />
                <div class="w-4 h-4 rounded-sm border-2 border-pink-200 bg-white group-hover:border-pink-300 peer-checked:bg-[#ff4b8b] peer-checked:border-[#ff4b8b] flex items-center justify-center transition-all">
                  <svg
                    class="w-3 h-3 text-white opacity-0 peer-checked:opacity-100 transition-opacity"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="3.5"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span class="text-[13px] font-medium text-gray-600 group-hover:text-[#ff4b8b] peer-checked:text-[#ff4b8b] peer-checked:font-bold transition-colors mt-[1px]">
                  {cat.label} <span class="text-gray-400 font-normal ml-0.5">({cat.count})</span>
                </span>
              </label>
            ))}
          </div>
        </div>

        <hr class="border-pink-50 mb-5" />

        <!-- Sección: Formato -->
        <div>
          <h3 class="flex items-center justify-between w-full text-left font-bold text-[#5e2154] text-sm mb-4">
            Formato
          </h3>
          <div class="space-y-3">
            {formatos.map((fmt) => (
              <label class="flex items-center gap-3 cursor-pointer group">
                <input
                  type="checkbox"
                  value={fmt.id}
                  data-group="formato"
                  class="filter-checkbox sr-only peer"
                />
                <div class="w-4 h-4 rounded-sm border-2 border-pink-200 bg-white group-hover:border-pink-300 peer-checked:bg-[#ff4b8b] peer-checked:border-[#ff4b8b] flex items-center justify-center transition-all">
                  <svg
                    class="w-3 h-3 text-white opacity-0 peer-checked:opacity-100 transition-opacity"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="3.5"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span class="text-[13px] font-medium text-gray-600 group-hover:text-[#ff4b8b] peer-checked:text-[#ff4b8b] peer-checked:font-bold transition-colors mt-[1px]">
                  {fmt.label} <span class="text-gray-400 font-normal ml-0.5">({fmt.count})</span>
                </span>
              </label>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</aside>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btnToggle = document.getElementById('btn-toggle-filtros');
    const content = document.getElementById('content-filtros');
    const arrow = document.getElementById('arrow-filtros');

    if (btnToggle && content && arrow) {
      btnToggle.addEventListener('click', () => {
        // Solo ejecutamos la animación del acordeón si estamos en móvil (< 1024px)
        if (window.innerWidth < 1024) {
          // Toggle de las clases que controlan la altura del grid
          if (content.classList.contains('grid-rows-[0fr]')) {
            // Abrir
            content.classList.remove('grid-rows-[0fr]');
            content.classList.add('grid-rows-[1fr]');
            arrow.classList.add('rotate-180');
          } else {
            // Cerrar
            content.classList.remove('grid-rows-[1fr]');
            content.classList.add('grid-rows-[0fr]');
            arrow.classList.remove('rotate-180');
          }
        }
      });
    }
  });
</script>
