---
// src/components/astro/Paginacion.astro
---

<div
  id="paginacion-container"
  class="flex items-center justify-center gap-1.5 sm:gap-2 mt-10 font-['Quicksand']"
>
  <button class="w-8 h-8 rounded-full flex items-center justify-center text-gray-400 hover:text-[#ff4b8b] hover:bg-pink-50 transition-colors">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
    </svg>
  </button>
  <button class="w-8 h-8 rounded-full bg-[#e6206b] text-white font-bold text-xs shadow-md">
    1
  </button>
  <button class="w-8 h-8 rounded-full text-gray-500 font-bold text-xs hover:bg-pink-50 hover:text-[#ff4b8b] transition-colors">
    2
  </button>
  <button class="w-8 h-8 rounded-full text-gray-500 font-bold text-xs hover:bg-pink-50 hover:text-[#ff4b8b] transition-colors">
    3
  </button>
  <button class="w-8 h-8 rounded-full text-gray-500 font-bold text-xs hover:bg-pink-50 hover:text-[#ff4b8b] transition-colors">
    4
  </button>
  <span class="text-gray-400 px-1">...</span>
  <button class="w-8 h-8 rounded-full text-gray-500 font-bold text-xs hover:bg-pink-50 hover:text-[#ff4b8b] transition-colors">
    12
  </button>
  <button class="w-8 h-8 rounded-full flex items-center justify-center text-gray-400 hover:text-[#ff4b8b] hover:bg-pink-50 transition-colors">
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
    </svg>
  </button>
</div>
