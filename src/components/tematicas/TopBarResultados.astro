---
// src/components/astro/TopBarResultados.astro
export interface Props {
  tematicaNombre: string;
  totalProductos: number;
}

const { tematicaNombre, totalProductos } = Astro.props;
---

<div class="w-full mb-6">
  <!-- Breadcrumbs (Migas de pan) -->
  <nav
    class="flex text-[10px] sm:text-xs text-gray-500 mb-5 sm:mb-6 font-medium whitespace-nowrap overflow-x-auto [&::-webkit-scrollbar]:hidden"
    aria-label="Breadcrumb"
  >
    <ol class="inline-flex items-center space-x-1 sm:space-x-2">
      <li>
        <a href="/" class="hover:text-[#ff4b8b] transition-colors">
          Inicio
        </a>
      </li>
      <li>
        <span class="mx-1 opacity-60">&gt;</span>
      </li>
      <li>
        <a href="/tematicas" class="hover:text-[#ff4b8b] transition-colors">
          Temáticas
        </a>
      </li>
      <li>
        <span class="mx-1 opacity-60">&gt;</span>
      </li>
      <li class="text-[#2d2a4a] font-bold truncate max-w-[120px] sm:max-w-none" aria-current="page">
        {tematicaNombre}
      </li>
    </ol>
  </nav>

  <!-- Contenedor Principal de la Barra -->
  <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 lg:gap-6">
    <!-- Bloque 1: Título, Filtros Activos y Contador -->
    <div class="w-full lg:w-auto">
      <div class="flex flex-wrap items-center gap-3 mb-1.5">
        <h1 class="text-xl sm:text-2xl md:text-3xl font-extrabold text-[#b31454] font-['Quicksand'] leading-tight">
          Temática: {tematicaNombre}
        </h1>

        <!-- Botón Limpiar Filtros -->
        <button
          id="btn-limpiar-filtros"
          class="hidden items-center gap-1 bg-pink-50 text-[#ff4b8b] text-[10px] font-bold px-2 py-1.5 rounded-md hover:bg-pink-100 transition-colors opacity-0 animate-fade-in shrink-0"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2.5"
            stroke="currentColor"
            class="w-3 h-3"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
          Limpiar filtros
        </button>
      </div>

      <p class="text-xs sm:text-[13px] font-bold text-[#2d2a4a] font-['Quicksand'] opacity-80">
        Mostrando{' '}
        <span id="contador-actual" class="text-[#e6206b] font-extrabold">
          {totalProductos}
        </span>{' '}
        de {totalProductos} productos
      </p>
    </div>

    <!-- Bloque 2: Controles de Ordenamiento y Vistas -->
    <div class="flex items-center w-full lg:w-auto gap-3 font-['Quicksand'] relative z-30 mt-2 lg:mt-0">
      <!-- Texto "Ordenar por" (Oculto en móvil) -->
      <span class="text-[13px] xl:text-[14px] font-bold text-[#2d2a4a] whitespace-nowrap hidden sm:block">
        Ordenar por:
      </span>

      <!-- Contenedor del Select Personalizado (Se expande en móvil) -->
      <div class="relative flex-1 sm:flex-none sm:w-[170px]" id="custom-select-container">
        <button
          id="custom-select-btn"
          class="flex items-center justify-between w-full h-[42px] px-3.5 bg-white border border-pink-200 hover:border-[#e6206b] rounded-xl text-[#2d2a4a] text-[13px] font-bold shadow-sm focus:outline-none focus:border-[#e6206b] focus:ring-2 focus:ring-pink-100 transition-all"
          aria-haspopup="listbox"
          aria-expanded="false"
        >
          <span id="custom-select-text" class="truncate pr-2">
            Más recientes
          </span>
          <svg
            id="custom-select-arrow"
            class="w-4 h-4 text-[#2d2a4a] transition-transform duration-300 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <!-- Opciones del Select -->
        <ul
          id="custom-select-options"
          class="absolute z-30 w-full mt-2 bg-white border border-gray-100 rounded-xl shadow-[0_10px_40px_-10px_rgba(0,0,0,0.15)] opacity-0 invisible translate-y-[-10px] transition-all duration-200 overflow-hidden"
          role="listbox"
        >
          <li
            data-sort="recent"
            class="px-4 py-3 bg-pink-50/50 hover:bg-pink-50 cursor-pointer text-[13px] font-bold text-[#e6206b] transition-colors"
            role="option"
          >
            Más recientes
          </li>
          <li
            data-sort="price-asc"
            class="px-4 py-3 hover:bg-pink-50 cursor-pointer text-[13px] font-bold text-[#2d2a4a] transition-colors"
            role="option"
          >
            Menor precio
          </li>
          <li
            data-sort="price-desc"
            class="px-4 py-3 hover:bg-pink-50 cursor-pointer text-[13px] font-bold text-[#2d2a4a] transition-colors"
            role="option"
          >
            Mayor precio
          </li>
          <li
            data-sort="popular"
            class="px-4 py-3 hover:bg-pink-50 cursor-pointer text-[13px] font-bold text-[#2d2a4a] transition-colors"
            role="option"
          >
            Más populares
          </li>
        </ul>
      </div>

      <!-- Toggle Vistas (Grid / List) (Tamaño fijo) -->
      <div class="flex items-center bg-white border border-gray-200 rounded-xl overflow-hidden shadow-sm h-[42px] w-[88px] shrink-0">
        <button
          id="btn-view-grid"
          class="flex-1 h-full bg-[#e6206b] text-white flex items-center justify-center transition-colors focus:outline-none"
          aria-label="Vista cuadrícula"
        >
          <svg class="w-4.5 h-4.5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M4 4h6v6H4V4zm10 0h6v6h-6V4zM4 14h6v6H4v-6zm10 0h6v6h-6v-6z" />
          </svg>
        </button>
        <button
          id="btn-view-list"
          class="flex-1 h-full bg-white text-gray-400 hover:text-[#e6206b] flex items-center justify-center transition-colors focus:outline-none"
          aria-label="Vista lista"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="2.5"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .animate-fade-in {
    animation: fadeIn 0.3s ease-in forwards;
  }
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(-5px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // --- Lógica del Select Personalizado ---
    const selectContainer = document.getElementById('custom-select-container');
    const selectBtn = document.getElementById('custom-select-btn');
    const selectText = document.getElementById('custom-select-text');
    const selectArrow = document.getElementById('custom-select-arrow');
    const selectOptions = document.getElementById('custom-select-options');
    const options = selectOptions?.querySelectorAll('li');

    let isOpen = false;

    const toggleSelect = () => {
      isOpen = !isOpen;
      if (isOpen) {
        selectOptions?.classList.remove('opacity-0', 'invisible', 'translate-y-[-10px]');
        selectOptions?.classList.add('opacity-100', 'visible', 'translate-y-0');
        selectArrow?.classList.add('rotate-180');
        selectBtn?.classList.add('border-[#e6206b]', 'ring-2', 'ring-pink-100');
      } else {
        selectOptions?.classList.add('opacity-0', 'invisible', 'translate-y-[-10px]');
        selectOptions?.classList.remove('opacity-100', 'visible', 'translate-y-0');
        selectArrow?.classList.remove('rotate-180');
        selectBtn?.classList.remove('ring-2', 'ring-pink-100');
      }
    };

    selectBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleSelect();
    });

    options?.forEach((option) => {
      option.addEventListener('click', () => {
        if (selectText) selectText.textContent = option.textContent;

        options.forEach((opt) => {
          opt.classList.remove('text-[#e6206b]', 'bg-pink-50/50');
          opt.classList.add('text-[#2d2a4a]');
        });

        option.classList.remove('text-[#2d2a4a]');
        option.classList.add('text-[#e6206b]', 'bg-pink-50/50');

        toggleSelect();

        // Despachar evento para ordenar
        const sortType = option.getAttribute('data-sort');
        window.dispatchEvent(new CustomEvent('sort-products', { detail: { sort: sortType } }));
      });
    });

    // Cerrar al clickear fuera
    document.addEventListener('click', (e) => {
      if (isOpen && selectContainer && !selectContainer.contains(e.target as Node)) {
        toggleSelect();
      }
    });

    // --- Lógica del Toggle (Grid/Lista) ---
    const btnGrid = document.getElementById('btn-view-grid');
    const btnList = document.getElementById('btn-view-list');
    const gridContainer = document.getElementById('grid-productos');

    const setGridActive = () => {
      btnGrid?.classList.add('bg-[#e6206b]', 'text-white');
      btnGrid?.classList.remove('bg-white', 'text-gray-400', 'hover:text-[#e6206b]');

      btnList?.classList.remove('bg-[#e6206b]', 'text-white');
      btnList?.classList.add('bg-white', 'text-gray-400', 'hover:text-[#e6206b]');

      gridContainer?.classList.remove('list-view');
    };

    const setListActive = () => {
      btnList?.classList.add('bg-[#e6206b]', 'text-white');
      btnList?.classList.remove('bg-white', 'text-gray-400', 'hover:text-[#e6206b]');

      btnGrid?.classList.remove('bg-[#e6206b]', 'text-white');
      btnGrid?.classList.add('bg-white', 'text-gray-400', 'hover:text-[#e6206b]');

      gridContainer?.classList.add('list-view');
    };

    btnGrid?.addEventListener('click', setGridActive);
    btnList?.addEventListener('click', setListActive);
  });
</script>
