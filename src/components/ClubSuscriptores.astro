---
// src/components/astro/ClubSuscriptores.astro
---

<section class="w-full max-w-7xl mx-auto px-4 py-2">
  <!-- Banner Container -->
  <div class="relative w-full bg-gradient-to-r from-[#fae6f0] to-[#f8dce8] border border-pink-100 rounded-3xl sm:rounded-[2.5rem] shadow-sm overflow-hidden flex flex-col md:flex-row items-center justify-between p-6 sm:p-8 md:px-12 md:py-8 gap-6 md:gap-4">
    <!-- Left Section: Title & Icon -->
    <div class="flex items-center gap-3 shrink-0">
      <!-- Crown Icon Placeholder -->
      <div class="text-yellow-400">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="w-10 h-10 sm:w-12 sm:h-12 drop-shadow-sm"
        >
          <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z" />
        </svg>
      </div>
      <h2 class="text-[#b31454] font-extrabold font-['Quicksand'] text-2xl sm:text-3xl leading-none flex flex-col">
        <span>Club de</span>
        <span>Suscriptores</span>
      </h2>
    </div>

    <!-- Center Section: Text & Button -->
    <div class="flex flex-col items-center text-center max-w-md shrink-0">
      <h3 class="text-[#5e2154] font-bold font-['Quicksand'] text-sm sm:text-base md:text-lg mb-1">
        ¿Quieres más proyectos, clases y recursos?
      </h3>
      <p class="text-[#5e2154]/80 font-medium font-['Quicksand'] text-xs sm:text-sm leading-tight mb-4 px-2">
        Únete al Club de Suscriptores y disfruta de contenido exclusivo en Team Crafter Web.
      </p>
      <a
        href="/unirme"
        class="inline-flex items-center justify-center gap-1.5 bg-[#e6206b] text-white font-bold font-['Quicksand'] text-sm px-6 py-2.5 rounded-full hover:bg-[#c21455] hover:scale-105 hover:shadow-md transition-all active:scale-95"
      >
        Quiero unirme &rarr;
      </a>
    </div>

    <!-- Right Section: Illustration -->
    <!-- Replace the src with your actual illustration image from the design -->
    <div class="w-full md:w-auto flex justify-center shrink-0 mt-4 md:mt-0">
      <img
        src="https://api.dicebear.com/7.x/shapes/svg?seed=Laptop&backgroundColor=fae6f0&shape1Color=ffffff"
        alt="Team Crafter Web en laptop"
        class="w-[180px] sm:w-[220px] md:w-[250px] h-auto object-contain drop-shadow-lg"
        loading="lazy"
      />
    </div>
  </div>
</section>
