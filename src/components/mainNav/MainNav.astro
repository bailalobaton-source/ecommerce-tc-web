---
import TematicasDropdown from './components/TematicasDropdown.astro';
// src/components/astro/MainNav.astro
---

<nav class="w-full bg-white border-pink-100 relative z-50">
  <!-- 
    Contenedor Scrollable:
    - overflow-x-auto y flex-nowrap permiten el deslizamiento horizontal en móviles.
    - Las clases de scrollbar ocultan la barra gris fea en todos los navegadores.
    - md:justify-center centra el menú en pantallas de PC.
  -->
  <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-start md:justify-center gap-3 overflow-x-auto flex-nowrap [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none] scroll-smooth">
    <!-- 1. INICIO -->
    <!-- shrink-0 evita que el botón se comprima cuando hay poco espacio en el celular -->
    <a
      href="/"
      class="shrink-0 flex items-center gap-1.5 px-4 py-2 rounded-full text-[#ff4b8b] font-bold hover:bg-pink-50 hover:scale-105 transition-all whitespace-nowrap text-sm font-['Quicksand']"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2.5"
        stroke="currentColor"
        class="w-4 h-4"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"
        />
      </svg>
      Inicio
    </a>

    <!-- 2. TEMÁTICAS -->
    <div class="shrink-0">
      <TematicasDropdown />
    </div>

    <!-- 3. CATEGORÍAS (Mejorado para no cortarse con el scroll) -->
    <!-- NOTA: Se eliminó la clase 'relative' de este div para que el submenú no se corte -->
    <div class="group shrink-0">
      <button class="flex items-center gap-1 text-[#ff4b8b] font-bold font-['Quicksand'] text-sm px-4 py-2 rounded-full hover:bg-pink-50 transition-colors whitespace-nowrap outline-none">
        Categorías
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2.5"
          stroke="currentColor"
          class="w-3 h-3 group-hover:rotate-180 transition-transform duration-300"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
        </svg>
      </button>

      <!-- Contenedor del Dropdown centrado globalmente -->
      <div class="absolute left-0 top-full w-full flex justify-center pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-[100] pointer-events-none">
        <!-- Tarjeta del Dropdown -->
        <div class="pointer-events-auto bg-white rounded-2xl shadow-[0_10px_40px_-10px_rgba(0,0,0,0.15)] border border-pink-50 py-3 flex flex-col font-['Quicksand'] text-sm min-w-[200px] overflow-hidden">
          <a
            href="/categorias/papeleria-creativa"
            class="px-5 py-2.5 hover:bg-pink-50 text-gray-700 hover:text-[#ff4b8b] font-semibold transition-colors flex items-center gap-2"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-pink-300"></span> Papelería Creativa
          </a>
          <a
            href="/categorias/cartonaje"
            class="px-5 py-2.5 hover:bg-pink-50 text-gray-700 hover:text-[#ff4b8b] font-semibold transition-colors flex items-center gap-2"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-pink-300"></span> Cartonaje
          </a>
          <a
            href="/categorias/colecciones"
            class="px-5 py-2.5 hover:bg-pink-50 text-gray-700 hover:text-[#ff4b8b] font-semibold transition-colors flex items-center gap-2"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-pink-300"></span> Colecciones Digitales
          </a>
        </div>
      </div>
    </div>

    <!-- 4. NOVEDADES -->
    <a
      href="/novedades"
      class="shrink-0 px-4 py-2 rounded-full text-[#ff4b8b] font-bold hover:bg-pink-50 hover:scale-105 transition-all whitespace-nowrap text-sm font-['Quicksand']"
    >
      Novedades
    </a>

    <!-- 5. PROMOCIONES -->
    <a
      href="/promociones"
      class="shrink-0 px-4 py-2 rounded-full text-[#ff4b8b] font-bold hover:bg-pink-50 hover:scale-105 transition-all whitespace-nowrap text-sm font-['Quicksand']"
    >
      Promociones
    </a>

    <!-- 6. CLUB DE SUSCRIPTORES (Diseño Premium) -->
    <a
      href="/club"
      class="shrink-0 flex items-center gap-1.5 px-6 py-2.5 rounded-full bg-gradient-to-r from-[#40c4c4] to-[#3bb5b5] text-white font-bold hover:shadow-[0_4px_15px_rgba(64,196,196,0.4)] hover:-translate-y-0.5 transition-all whitespace-nowrap text-sm font-['Quicksand'] md:ml-2 relative overflow-hidden group"
    >
      <!-- Brillo animado al pasar el mouse -->
      <div class="absolute inset-0 -translate-x-full group-hover:animate-[shimmer_1.5s_infinite] bg-gradient-to-r from-transparent via-white/30 to-transparent"></div>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2.5"
        stroke="currentColor"
        class="w-4 h-4"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z"
        />
      </svg>
      Club de Suscriptores
    </a>
  </div>
</nav>
