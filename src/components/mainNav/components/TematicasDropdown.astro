---
// src/components/astro/TematicasDropdown.astro

const tematicas = [
  {
    nombre: 'Barbie',
    imagen: 'https://api.dicebear.com/7.x/avataaars/svg?seed=Barbie&backgroundColor=fce4ec',
    slug: 'barbie',
  },
  {
    nombre: 'Bella Y Bestia',
    imagen: 'https://api.dicebear.com/7.x/avataaars/svg?seed=Bella&backgroundColor=fff9c4',
    slug: 'bella-y-bestia',
  },
  {
    nombre: 'Hadas',
    imagen: 'https://api.dicebear.com/7.x/avataaars/svg?seed=Hadas&backgroundColor=e0f7fa',
    slug: 'hadas',
  },
  {
    nombre: 'My Little Pony',
    imagen: 'https://api.dicebear.com/7.x/avataaars/svg?seed=Pony&backgroundColor=f3e5f5',
    slug: 'my-little-pony',
  },
  {
    nombre: 'Cazadoras Kpop',
    imagen: 'https://api.dicebear.com/7.x/avataaars/svg?seed=Kpop&backgroundColor=ede7f6',
    slug: 'cazadoras-kpop',
  },
  {
    nombre: 'Toy Story',
    imagen: 'https://api.dicebear.com/7.x/avataaars/svg?seed=Toy&backgroundColor=e8f5e9',
    slug: 'toy-story',
  },
  {
    nombre: 'Mario Bros',
    imagen: 'https://api.dicebear.com/7.x/avataaars/svg?seed=Mario&backgroundColor=e3f2fd',
    slug: 'mario-bros',
  },
  {
    nombre: 'Fresita',
    imagen: 'https://api.dicebear.com/7.x/avataaars/svg?seed=Fresita&backgroundColor=ffebee',
    slug: 'fresita',
  },
  {
    nombre: 'Hadas',
    imagen: 'https://api.dicebear.com/7.x/avataaars/svg?seed=Hadas2&backgroundColor=e0f7fa',
    slug: 'hadas-2',
  },
  {
    nombre: 'My Little Pony',
    imagen: 'https://api.dicebear.com/7.x/avataaars/svg?seed=Pony2&backgroundColor=f3e5f5',
    slug: 'my-little-pony-2',
  },
  {
    nombre: 'Cazadoras Kpop',
    imagen: 'https://api.dicebear.com/7.x/avataaars/svg?seed=Kpop2&backgroundColor=ede7f6',
    slug: 'cazadoras-kpop-2',
  },
  {
    nombre: 'Toy Story',
    imagen: 'https://api.dicebear.com/7.x/avataaars/svg?seed=Toy2&backgroundColor=e8f5e9',
    slug: 'toy-story-2',
  },
];
---

<!-- 1. ELIMINAMOS la clase 'relative' de este div padre -->
<div id="tematicas-dropdown">
  <!-- Botón Disparador -->
  <button
    id="tematicas-btn"
    class="flex items-center gap-1 bg-[#ff4b8b] text-white font-bold font-['Quicksand'] text-sm px-5 py-2.5 rounded-full shadow-sm whitespace-nowrap hover:bg-[#ff307b] hover:shadow-md transition-all focus:outline-none"
    aria-haspopup="true"
    aria-expanded="false"
  >
    Temáticas
    <svg
      id="tematicas-arrow"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="2.5"
      stroke="currentColor"
      class="w-3 h-3 transition-transform duration-300"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
    </svg>
  </button>

  <!-- 2. Contenedor de Posicionamiento (Ocupa el 100% de la pantalla para poder centrar) -->
  <!-- 'pointer-events-none' evita que este div invisible bloquee los clics en otras partes de la página -->
  <div
    id="tematicas-menu"
    class="absolute left-0 top-full w-full flex justify-center pt-2 sm:pt-4 px-3 opacity-0 invisible translate-y-2 transition-all duration-300 z-60 pointer-events-none"
  >
    <!-- 3. Tarjeta Blanca del Menú (Centrada automáticamente por el padre) -->
    <!-- 'pointer-events-auto' reactiva los clics solo dentro del recuadro blanco -->
    <div class="pointer-events-auto bg-white rounded-3xl sm:rounded-[2.5rem] shadow-[0_20px_60px_-15px_rgba(0,0,0,0.2)] border border-pink-50 p-5 sm:p-8 flex flex-col items-center w-full max-w-[360px] sm:max-w-[600px] lg:max-w-[750px]">
      <!-- Cuadrícula de Íconos: 3 columnas en móvil (idéntico a tu foto), 4 a 6 en pantallas grandes -->
      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-6 gap-x-2 sm:gap-x-4 gap-y-5 sm:gap-y-8 w-full mb-6 sm:mb-8">
        {tematicas.map((item) => (
          <a
            href={`/tematicas/${item.slug}`}
            class="flex flex-col items-center gap-1.5 sm:gap-3 group/item hover:-translate-y-1 transition-transform duration-300"
          >
            <div class="w-14 h-14 sm:w-20 sm:h-20 md:w-22 md:h-22 rounded-full overflow-hidden border-[3px] border-transparent group-hover/item:border-pink-300 group-hover/item:shadow-md group-hover/item:shadow-pink-200/50 transition-all duration-300 bg-pink-50 flex-shrink-0">
              <img
                src={item.imagen}
                alt={item.nombre}
                class="w-full h-full object-cover scale-90 group-hover/item:scale-100 transition-transform duration-300"
                loading="lazy"
              />
            </div>
            <!-- Texto del ícono -->
            <span class="text-[11px] sm:text-[13px] font-['Quicksand'] font-bold text-gray-700 text-center leading-tight group-hover/item:text-[#ff4b8b] transition-colors">
              {item.nombre}
            </span>
          </a>
        ))}
      </div>

      <!-- Botón Rosa Claro inferior (Mejorado para igualar tu captura) -->
      <a
        href="/tematicas"
        class="inline-flex items-center gap-2 bg-[#ffecf2] text-[#ff4b8b] font-bold font-['Quicksand'] text-xs sm:text-base px-8 py-3 rounded-full hover:bg-[#ff4b8b] hover:text-white transition-all w-[90%] sm:w-auto justify-center"
      >
        Ver todas las temáticas
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2.5"
          stroke="currentColor"
          class="w-4 h-4"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
        </svg>
      </a>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('tematicas-dropdown');
    const btn = document.getElementById('tematicas-btn');
    const menu = document.getElementById('tematicas-menu');
    const arrow = document.getElementById('tematicas-arrow');

    if (!container || !btn || !menu || !arrow) return;

    let isOpen = false;

    const toggleMenu = (forceState?: boolean) => {
      isOpen = forceState !== undefined ? forceState : !isOpen;

      if (isOpen) {
        menu.classList.remove('opacity-0', 'invisible', 'translate-y-2');
        menu.classList.add('opacity-100', 'visible', 'translate-y-0');
        arrow.classList.add('rotate-180');
      } else {
        menu.classList.remove('opacity-100', 'visible', 'translate-y-0');
        menu.classList.add('opacity-0', 'invisible', 'translate-y-2');
        arrow.classList.remove('rotate-180');
      }
    };

    btn.addEventListener('click', (e: Event) => {
      e.preventDefault();
      e.stopPropagation();
      toggleMenu();
    });

    container.addEventListener('mouseenter', () => {
      if (window.matchMedia('(hover: hover)').matches) {
        toggleMenu(true);
      }
    });

    container.addEventListener('mouseleave', () => {
      if (window.matchMedia('(hover: hover)').matches) {
        toggleMenu(false);
      }
    });

    document.addEventListener('click', (event: MouseEvent) => {
      if (isOpen && !container.contains(event.target as Node)) {
        toggleMenu(false);
      }
    });

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape' && isOpen) {
        toggleMenu(false);
      }
    });
  });
</script>
