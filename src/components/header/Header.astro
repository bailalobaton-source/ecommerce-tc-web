---
import AccountButton from './components/AccountButton';
import CartButton from './components/CartButton';
import SearchBar from './components/SearchBar';
---

<!-- 1. Movimos el bg-[url('/brillos.gif')], bg-repeat y bg-right-top al HEADER -->
<!-- 2. Agregamos bg-blend-screen para que el fondo negro del GIF (si lo tiene) se fusione con el rosa -->
<header class="relative overflow-hidden bg-[#ff4b8b] bg-[url('/brillos.gif')] bg-repeat bg-top-right bg-blend-screen text-white w-full shadow-sm border-b border-pink-400/30">
  <!-- Contenedor principal -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 py-3 sm:py-4 flex flex-wrap md:flex-nowrap items-center justify-between gap-4 md:gap-6">
    <!-- LOGO -->
    <a href="/" class="shrink-0 flex items-center gap-2 hover:opacity-90 transition-opacity">
      <img src="/logo.webp" alt="Logo" class="h-10 w-auto" />
    </a>

    <!-- BUSCADOR -->
    <SearchBar client:load />

    <!-- ACCIONES LADO DERECHO (Idioma, Cuenta, Carrito) -->
    <div class="flex items-center gap-3 sm:gap-5 shrink-0 font-['Quicksand'] font-semibold text-xs sm:text-sm">
      <!-- Cambio de Idioma -->
      <button class="flex items-center gap-1 hover:text-yellow-200 transition-colors group">
        <span>Español</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2.5"
          stroke="currentColor"
          class="w-3 h-3 group-hover:rotate-180 transition-transform duration-300"
        >
          <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
        </svg>
      </button>

      <div class="hidden sm:block w-px h-6 bg-pink-400"></div>

      <!-- Mi Cuenta -->
      <AccountButton client:load />

      <!-- Carrito -->
      <CartButton client:load />
    </div>
  </div>
</header>
