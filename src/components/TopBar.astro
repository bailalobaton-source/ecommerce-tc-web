---
// src/components/astro/TopBar.astro
---

<div class="relative overflow-hidden bg-gradient-to-r from-[#3bb5b5] via-[#40c4c4] to-[#3bb5b5] text-white py-1.5 sm:py-2 px-2 sm:px-4 w-full">
  <!-- Efecto de luz (Shimmer) más sutil para dar un toque premium sin competir con los brillos del Header -->
  <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full animate-[shimmer_3s_infinite]"></div>

  <!-- Contenedor Principal responsivo -->
  <div class="relative z-10 max-w-7xl mx-auto flex justify-center sm:justify-between items-center text-[9px] min-[380px]:text-[10px] sm:text-sm tracking-normal sm:tracking-widest">
    <div class="hidden sm:block w-8"></div>

    <p class="text-center flex-1 font-['Quicksand'] font-bold drop-shadow-sm flex items-center justify-center gap-1 sm:gap-2 px-6 sm:px-0 leading-tight">
      <!-- Intercambio de texto: Corto en móvil, completo en PC -->
      <span class="sm:hidden">BIENVENIDO A NUESTRA TIENDA DIGITAL</span>
      <span class="hidden sm:inline">BIENVENIDO A NUESTRA TIENDA ONLINE DE ARCHIVOS DIGITALES</span>
    </p>

    <!-- Botón de país posicionado absolutamente en móvil para evitar empujar el texto central -->
    <button
      aria-label="Cambiar país"
      class="absolute right-0 sm:static flex items-center hover:scale-110 transition-transform duration-300 group"
    >
      <span class="text-sm sm:text-lg drop-shadow-sm group-hover:rotate-12 transition-transform duration-300">
        🇵🇪
      </span>
    </button>
  </div>
</div>

<style>
  @keyframes shimmer {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(120%);
    }
  }
</style>
