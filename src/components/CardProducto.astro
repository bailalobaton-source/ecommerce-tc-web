---
// src/components/astro/CardProducto.astro

export interface Props {
  nombre: string;
  formatos: string;
  precio: string;
  imagen: string;
  badge?: string; // Ej: 'Bestseller' o 'Nuevo'
  badgeColor?: string; // Ej: 'bg-[#ff9f43]' (naranja) o 'bg-[#ff4b8b]' (rosa)
  enlace?: string; // Link al detalle del producto
}

const {
  nombre,
  formatos = 'STUDIO / SVG / PDF',
  precio,
  imagen,
  badge,
  badgeColor = 'bg-[#ff4b8b]',
  enlace = '#',
} = Astro.props;
---

<article class="w-full bg-white rounded-3xl border border-gray-100 shadow-[0_4px_15px_-5px_rgba(255,75,139,0.1)] hover:shadow-[0_8px_25px_-5px_rgba(255,75,139,0.2)] hover:-translate-y-1 transition-all duration-300 p-2.5 flex flex-col group relative">
  <!-- Contenedor de Imagen -->
  <a
    href={enlace}
    class="relative block aspect-square rounded-[1.25rem] overflow-hidden bg-pink-50 mb-3"
  >
    <img
      src={imagen}
      alt={nombre}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
      loading="lazy"
    />

    <!-- Etiqueta (Badge) opcional -->
    {badge && (
      <div
        class={`absolute top-2 left-2 ${badgeColor} text-white text-[10px] font-extrabold font-['Quicksand'] px-2.5 py-0.5 rounded-full shadow-sm z-10 tracking-wide`}
      >
        {badge}
      </div>
    )}

    <!-- Ícono Corazón (Favoritos) -->
    <!-- Nota: Se usa object-element z-20 para que el clic en el corazón no te lleve al enlace del producto accidentalmente -->
    <button
      class="absolute top-2 right-2 bg-white/90 backdrop-blur-sm text-gray-500 hover:text-[#ff4b8b] p-1.5 rounded-full shadow-sm z-20 transition-colors focus:outline-none"
      aria-label="Agregar a favoritos"
      onclick="event.preventDefault(); /* Aquí irá tu lógica de favoritos */"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2.5"
        stroke="currentColor"
        class="w-4 h-4"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"
        />
      </svg>
    </button>
  </a>

  <!-- Información del Producto -->
  <div class="flex flex-col flex-1 px-1">
    <!-- Título -->
    <a
      href={enlace}
      class="text-[#2d2a4a] font-extrabold font-['Quicksand'] text-sm leading-tight line-clamp-1 group-hover:text-[#ff4b8b] transition-colors mb-0.5"
    >
      {nombre}
    </a>

    <!-- Formatos -->
    <p class="text-[9px] font-bold text-gray-400 font-['Quicksand'] tracking-wide mb-3 uppercase">
      {formatos}
    </p>

    <!-- Fila Inferior: Precio y Botón Carrito -->
    <div class="flex items-center justify-between mt-auto">
      <span class="text-[#e6206b] font-extrabold font-['Quicksand'] text-base">S/ {precio}</span>

      <!-- Botón Agregar al Carrito -->
      <button
        class="bg-[#ff4b8b] hover:bg-[#e6206b] text-white px-3 py-1.5 rounded-2xl shadow-md shadow-pink-200 hover:shadow-lg transition-all focus:outline-none active:scale-95 z-20"
        aria-label="Agregar al carrito"
        onclick="/* Aquí irá tu lógica de carrito (Nano Stores / React) */"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2.5"
          stroke="currentColor"
          class="w-4.5 h-4.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"
          />
        </svg>
      </button>
    </div>
  </div>
</article>
