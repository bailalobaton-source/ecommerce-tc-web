---
// src/components/astro/LoMasReciente.astro
import CardProducto from './CardProducto.astro';

const productosRecientes = [
  {
    id: 1,
    nombre: 'Caja Reno',
    formatos: 'STUDIO / SVG / PDF',
    precio: '12.90',
    badge: 'Bestseller',
    badgeColor: 'bg-[#ff9f43]',
    imagen:
      'https://images.unsplash.com/photo-1512474932049-78ac69ede12c?q=80&w=500&auto=format&fit=crop',
  },
  {
    id: 2,
    nombre: 'Caja Reno',
    formatos: 'STUDIO / SVG / PDF',
    precio: '12.90',
    badge: 'Bestseller',
    badgeColor: 'bg-[#ff9f43]',
    imagen:
      'https://images.unsplash.com/photo-1512474932049-78ac69ede12c?q=80&w=500&auto=format&fit=crop',
  },
  {
    id: 3,
    nombre: 'Caja Reno',
    formatos: 'STUDIO / SVG / PDF',
    precio: '12.90',
    badge: 'Bestseller',
    badgeColor: 'bg-[#ff9f43]',
    imagen:
      'https://images.unsplash.com/photo-1512474932049-78ac69ede12c?q=80&w=500&auto=format&fit=crop',
  },
  {
    id: 4,
    nombre: 'Caja Reno',
    formatos: 'STUDIO / SVG / PDF',
    precio: '12.90',
    badge: 'Bestseller',
    badgeColor: 'bg-[#ff9f43]',
    imagen:
      'https://images.unsplash.com/photo-1512474932049-78ac69ede12c?q=80&w=500&auto=format&fit=crop',
  },
];

// Repetimos el texto lo suficiente para que cubra pantallas ultra anchas
const textoCinta = 'Descubre lo más reciente - '.repeat(15);
---

<section class="w-full mt-12 mb-8 drop-shadow-sm">
  <!-- 1. BLOQUE PRINCIPAL ROSADO (Con tu fondo optimizado) -->
  <div class="relative overflow-hidden bg-[#ff4b8b] bg-[url('/brillos.gif')] bg-repeat bg-right-top bg-blend-screen text-white w-full shadow-sm border-b border-pink-400/30">
    <!-- Cinta de Texto Animada -->
    <div class="w-full h-10 sm:h-12 overflow-hidden">
      <div class="cinta-animada font-extrabold font-['Quicksand'] text-lg sm:text-xl tracking-wide drop-shadow-md">
        {textoCinta}
      </div>
    </div>

    <!-- Contenido: Imagen Izquierda y Carrusel Derecha -->
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-end justify-between px-4 pb-6 pt-6 sm:pt-8 md:pt-10 gap-6">
      <!-- Izquierda: Modelo -->
      <div class="w-full md:w-1/3 lg:w-1/4 shrink-0 flex justify-center md:justify-start">
        <img
          src="https://api.dicebear.com/7.x/avataaars/svg?seed=Modelo&backgroundColor=transparent&style=circle"
          alt="Modelo mostrando productos"
          class="w-[200px] md:w-[250px] lg:w-[310px] h-auto object-contain object-bottom drop-shadow-[0_15px_25px_rgba(150,0,50,0.4)] hover:scale-105 transition-transform duration-700 origin-bottom"
        />
      </div>

      <!-- Derecha: Carrusel de Productos -->
      <div class="w-full md:w-2/3 lg:w-3/4 text-gray-800">
        <!-- text-gray-800 asegura que las tarjetas no hereden el text-white del padre -->
        <div class="flex gap-3 sm:gap-4 md:gap-5 overflow-x-auto snap-x snap-mandatory py-4 -mx-2 px-2 [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]">
          {productosRecientes.map((prod) => (
            <div class="shrink-0 snap-start w-[160px] sm:w-[180px] md:w-[210px]">
              <CardProducto
                nombre={prod.nombre}
                formatos={prod.formatos}
                precio={prod.precio}
                imagen={prod.imagen}
                badge={prod.badge}
                badgeColor={prod.badgeColor}
              />
            </div>
          ))}
          <div class="shrink-0 w-4 md:hidden"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. BARRA INFERIOR DE BENEFICIOS -->
  <div class="w-full bg-white border-b border-pink-100 shadow-[0_10px_30px_-15px_rgba(255,75,139,0.15)] relative z-20">
    <div class="max-w-7xl mx-auto px-4 py-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-0 divide-y sm:divide-y-0 sm:divide-x divide-pink-50">
        <!-- Beneficio 1 -->
        <div class="group flex items-center gap-3.5 justify-center sm:justify-start lg:justify-center py-2 sm:px-4 hover:-translate-y-1 transition-transform duration-300 cursor-default">
          <div class="bg-pink-50 p-2.5 rounded-full group-hover:bg-pink-100 transition-colors duration-300">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke="#ff4b8b"
              class="w-6 h-6 sm:w-7 sm:h-7 shrink-0"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z"
              />
            </svg>
          </div>
          <div class="font-['Quicksand']">
            <p class="text-[#2d2a4a] font-extrabold text-xs sm:text-sm leading-tight group-hover:text-[#ff4b8b] transition-colors">
              Descarga inmediata
            </p>
            <p class="text-gray-500 font-medium text-[10px] sm:text-xs">Tras tu compra</p>
          </div>
        </div>

        <!-- Beneficio 2 -->
        <div class="group flex items-center gap-3.5 justify-center sm:justify-start lg:justify-center py-2 sm:px-4 hover:-translate-y-1 transition-transform duration-300 cursor-default">
          <div class="bg-pink-50 p-2.5 rounded-full group-hover:bg-pink-100 transition-colors duration-300">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke="#ff4b8b"
              class="w-6 h-6 sm:w-7 sm:h-7 shrink-0"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8.25 15L12 18.75 15.75 15m-7.5-6L12 5.25 15.75 9"
              />
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75V5.25" />
            </svg>
          </div>
          <div class="font-['Quicksand']">
            <p class="text-[#2d2a4a] font-extrabold text-xs sm:text-sm leading-tight group-hover:text-[#ff4b8b] transition-colors">
              Acceso por 30 días
            </p>
            <p class="text-gray-500 font-medium text-[10px] sm:text-xs">Para tus descargas</p>
          </div>
        </div>

        <!-- Beneficio 3 -->
        <div class="group flex items-center gap-3.5 justify-center sm:justify-start lg:justify-center py-2 sm:px-4 hover:-translate-y-1 transition-transform duration-300 cursor-default">
          <div class="bg-pink-50 p-2.5 rounded-full group-hover:bg-pink-100 transition-colors duration-300">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke="#ff4b8b"
              class="w-6 h-6 sm:w-7 sm:h-7 shrink-0"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"
              />
            </svg>
          </div>
          <div class="font-['Quicksand']">
            <p class="text-[#2d2a4a] font-extrabold text-xs sm:text-sm leading-tight group-hover:text-[#ff4b8b] transition-colors">
              Hasta 3 descargas
            </p>
            <p class="text-gray-500 font-medium text-[10px] sm:text-xs">Por cada producto</p>
          </div>
        </div>

        <!-- Beneficio 4 -->
        <div class="group flex items-center gap-3.5 justify-center sm:justify-start lg:justify-center py-2 sm:px-4 hover:-translate-y-1 transition-transform duration-300 cursor-default">
          <div class="bg-pink-50 p-2.5 rounded-full group-hover:bg-pink-100 transition-colors duration-300">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke="#ff4b8b"
              class="w-6 h-6 sm:w-7 sm:h-7 shrink-0"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
          </div>
          <div class="font-['Quicksand']">
            <p class="text-[#2d2a4a] font-extrabold text-xs sm:text-sm leading-tight group-hover:text-[#ff4b8b] transition-colors">
              Archivos de calidad
            </p>
            <p class="text-gray-500 font-medium text-[10px] sm:text-xs">Listos para tus plotters</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CSS exacto para el loop infinito -->
<style>
  .cinta-animada {
    display: flex;
    align-items: center;
    height: 100%;
    white-space: nowrap;
    width: max-content;
    animation: 25s linear 0s infinite normal none running slider;
  }

  @keyframes slider {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
</style>
