---
// src/components/astro/BannerCategorias.astro

const categorias = [
  {
    nombre: 'Papelería Creativa',
    slug: 'papeleria-creativa',
    // Colores basados en la primera tarjeta (Rosa)
    borderColor: 'border-[#ffa3c1]',
    badgeBg: 'bg-[#ffe6ee]',
    badgeText: 'text-[#d81b60]',
    shadowHover: 'group-hover:shadow-[0_8px_20px_-6px_rgba(255,163,193,0.6)]',
    // Usamos placeholder temporal, luego lo cambias por tu imagen de la impresora
    imagen:
      'https://api.dicebear.com/7.x/shapes/svg?seed=Papeleria&backgroundColor=ffb3ba&shape1Color=ffffff',
  },
  {
    nombre: 'Cartonaje',
    slug: 'cartonaje',
    // Colores basados en la segunda tarjeta (Amarillo)
    borderColor: 'border-[#ffdf6b]',
    badgeBg: 'bg-[#fff8d6]',
    badgeText: 'text-[#b28900]',
    shadowHover: 'group-hover:shadow-[0_8px_20px_-6px_rgba(255,223,107,0.6)]',
    imagen:
      'https://api.dicebear.com/7.x/shapes/svg?seed=Cartonaje&backgroundColor=ffffba&shape1Color=ffffff',
  },
  {
    nombre: 'Colecciones Digitales',
    slug: 'colecciones',
    // Colores basados en la tercera tarjeta (Azul)
    borderColor: 'border-[#8fc8ff]',
    badgeBg: 'bg-[#e6f4ff]',
    badgeText: 'text-[#005fb8]',
    shadowHover: 'group-hover:shadow-[0_8px_20px_-6px_rgba(143,200,255,0.6)]',
    imagen:
      'https://api.dicebear.com/7.x/shapes/svg?seed=Colecciones&backgroundColor=bae1ff&shape1Color=ffffff',
  },
  {
    nombre: 'Libretas y Agendas',
    slug: 'libretas',
    // Colores basados en la cuarta tarjeta (Verde)
    borderColor: 'border-[#97e089]',
    badgeBg: 'bg-[#eafff0]',
    badgeText: 'text-[#2e7d32]',
    shadowHover: 'group-hover:shadow-[0_8px_20px_-6px_rgba(151,224,137,0.6)]',
    imagen:
      'https://api.dicebear.com/7.x/shapes/svg?seed=Libretas&backgroundColor=baffc9&shape1Color=ffffff',
  },
];
---

<section class="w-full max-w-7xl mx-auto px-4 pt-0">
  <!-- Banner Principal -->
  <div class="relative w-full bg-linear-to-r from-[#ffc8dd] to-[#ffafcc] border-[3px] border-[#ffa6c9] rounded-4xl sm:rounded-[3rem] p-6 sm:p-8 lg:p-10 flex flex-col lg:flex-row items-center justify-between gap-8 overflow-hidden shadow-sm">
    <!-- Decoración: Nubes en las esquinas inferiores (SVG estáticos) -->
    <svg
      class="absolute -bottom-2 -left-4 w-32 h-auto text-white/50"
      viewBox="0 0 200 100"
      fill="currentColor"
    >
      <path d="M50,90 Q40,60 70,60 Q80,30 110,40 Q140,20 160,50 Q190,60 180,90 Z" />
    </svg>
    <svg
      class="absolute -bottom-4 -right-4 w-40 h-auto text-white/40"
      viewBox="0 0 200 100"
      fill="currentColor"
    >
      <path d="M40,90 Q20,60 60,50 Q70,20 110,30 Q140,10 170,40 Q200,50 180,90 Z" />
    </svg>

    <!-- Izquierda: Textos y Botón -->
    <div class="relative z-10 flex flex-col items-center lg:items-start text-center lg:text-left w-full lg:w-[40%] shrink-0">
      <p class="text-[#5e2154] font-bold font-['Quicksand'] text-sm sm:text-base tracking-wide mb-1">
        Explora nuestras
      </p>

      <!-- Título con destellos amarillos -->
      <div class="relative inline-block mb-3">
        <!-- Destello izquierdo -->
        <svg
          class="absolute -left-6 top-1 w-5 h-5 text-yellow-400"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
        >
          <path d="M12 2v4M5 5l3 3M2 12h4" />
        </svg>

        <h2 class="text-[#5e2154] text-3xl sm:text-4xl md:text-5xl font-extrabold font-['Quicksand'] tracking-tight">
          Categorías
        </h2>

        <!-- Destello derecho -->
        <svg
          class="absolute -right-7 top-1 w-5 h-5 text-yellow-400"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
        >
          <path d="M12 2v4M19 5l-3 3M22 12h-4" />
        </svg>
      </div>

      <p class="text-[#5e2154]/80 font-['Quicksand'] font-medium text-xs sm:text-sm max-w-70 mb-5 leading-tight">
        Encuentra archivos digitales listos para tus proyectos creativos.
      </p>

      <a
        href="/categorias"
        class="inline-flex items-center gap-1.5 bg-[#e6206b] text-white font-bold font-['Quicksand'] text-xs sm:text-sm px-6 py-2.5 rounded-full hover:bg-[#c21455] hover:scale-105 transition-all shadow-md"
      >
        Ver todas las categorías &rarr;
      </a>
    </div>

    <!-- Derecha: Tarjetas Deslizables -->
    <div class="relative z-10 w-full flex overflow-x-auto snap-x snap-mandatory flex-nowrap items-center gap-3 sm:gap-4 pb-4 lg:pb-0 [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] scrollbar-none">
      {categorias.map((cat) => (
        <a
          href={`/categorias/${cat.slug}`}
          class={`group flex flex-col items-center justify-between shrink-0 snap-start bg-white rounded-[1.25rem] w-30 h-32.5 sm:w-32.5 sm:h-35 p-2 sm:p-2.5 border-4 ${cat.borderColor} hover:-translate-y-1 transition-all duration-300 ${cat.shadowHover} relative overflow-hidden`}
        >
          <!-- Contenedor de la Imagen (Icono) -->
          <div class="w-full h-16 sm:h-20 flex flex-col items-center justify-center mt-1">
            <img
              src={cat.imagen}
              alt={cat.nombre}
              class="h-full object-contain drop-shadow-sm group-hover:scale-110 transition-transform duration-300"
              loading="lazy"
            />
          </div>

          <!-- Píldora de texto inferior con guiones laterales -->
          <div
            class={`w-full flex items-center justify-center gap-1 mt-auto ${cat.badgeBg} rounded-full py-1.5 px-1`}
          >
            <!-- Guiones decorativos izq -->
            <svg
              class={`w-2 h-2 ${cat.badgeText} opacity-60`}
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="4"
              stroke-linecap="round"
            >
              <path d="M4 8l6 4-6 4" />
            </svg>

            <span
              class={`${cat.badgeText} text-[9px] sm:text-[10px] font-extrabold font-['Quicksand'] text-center leading-[1.1] truncate w-full px-0.5`}
            >
              {cat.nombre.includes(' ') ? (
                <>
                  {cat.nombre.split(' ')[0]} <br /> {cat.nombre.split(' ').slice(1).join(' ')}
                </>
              ) : (
                cat.nombre
              )}
            </span>

            <!-- Guiones decorativos der -->
            <svg
              class={`w-2 h-2 ${cat.badgeText} opacity-60`}
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="4"
              stroke-linecap="round"
            >
              <path d="M20 8l-6 4 6 4" />
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
