  #grid-productos.list-view .producto-item article > a.aspect-square {
    width: 140px;
    height: 140px;
    margin-bottom: 0;
    flex-shrink: 0;
  }

  #grid-productos.list-view .producto-item article .flex-1 {
    justify-content: center;
    padding-right: 1rem;
  }

  @media (max-width: 640px) {
    #grid-productos.list-view .producto-item article {
      padding: 0.75rem;
      gap: 1rem;
    }
    #grid-productos.list-view .producto-item article > a.aspect-square {
      width: 100px;
      height: 100px;
    }
  }
</style>
