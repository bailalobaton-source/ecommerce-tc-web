// 1. GENERAMOS RUTAS ESTÁTICAS DESDE LA BASE DE DATOS
export async function getStaticPaths() {
  const tematicasBD = await getTematicasGlobales();

  return tematicasBD.map((tematica) => {
    const slug = tematica.nombre_tematica
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/\s+/g, '-');

    return {
      params: { slug },
      props: { tematica }, // Pasamos el objeto Tematica completo como prop
    };
  });
}

