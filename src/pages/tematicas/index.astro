---
// src/pages/tematicas/index.astro
import Layout from '../../layouts/Layout.astro';

// Datos de ejemplo ampliados para que coincidan con el filtro
const tematicas = [
  {
    nombre: 'Barbie',
    imagen: 'https://api.dicebear.com/7.x/avataaars/svg?seed=Barbie&backgroundColor=fce4ec',
    slug: 'barbie',
  },
  {
    nombre: 'Bella Y Bestia',
    imagen: 'https://api.dicebear.com/7.x/avataaars/svg?seed=Bella&backgroundColor=fff9c4',
    slug: 'bella-y-bestia',
  },
  {
    nombre: 'Hadas',
    imagen: 'https://api.dicebear.com/7.x/avataaars/svg?seed=Hadas&backgroundColor=e0f7fa',
    slug: 'hadas',
  },
  {
    nombre: 'My Little Pony',
    imagen: 'https://api.dicebear.com/7.x/avataaars/svg?seed=Pony&backgroundColor=f3e5f5',
    slug: 'my-little-pony',
  },
  {
    nombre: 'Cazadoras Kpop',
    imagen: 'https://api.dicebear.com/7.x/avataaars/svg?seed=Kpop&backgroundColor=ede7f6',
    slug: 'cazadoras-kpop',
  },
  {
    nombre: 'Toy Story',
    imagen: 'https://api.dicebear.com/7.x/avataaars/svg?seed=Toy&backgroundColor=e8f5e9',
    slug: 'toy-story',
  },
  {
    nombre: 'Mario Bros',
    imagen: 'https://api.dicebear.com/7.x/avataaars/svg?seed=Mario&backgroundColor=e3f2fd',
    slug: 'mario-bros',
  },
  {
    nombre: 'Fresita',
    imagen: 'https://api.dicebear.com/7.x/avataaars/svg?seed=Fresita&backgroundColor=ffebee',
    slug: 'fresita',
  },
  {
    nombre: 'American Girl',
    imagen: 'https://api.dicebear.com/7.x/avataaars/svg?seed=American&backgroundColor=ffebee',
    slug: 'american-girl',
  },
  {
    nombre: 'Disney Frozen',
    imagen: 'https://api.dicebear.com/7.x/avataaars/svg?seed=Frozen&backgroundColor=e0f7fa',
    slug: 'disney-frozen',
  },
  {
    nombre: 'Hot Wheels',
    imagen: 'https://api.dicebear.com/7.x/avataaars/svg?seed=Wheels&backgroundColor=fff9c4',
    slug: 'hot-wheels',
  },
];

// Datos del índice lateral
const brandsIndex = [
  { letter: 'A', links: ['American Girl'] },
  { letter: 'B', links: ['Barbie', 'Barney'] },
  {
    letter: 'D',
    links: [
      'DC Universe',
      'Disney',
      'Descendants',
      'Disney Frozen',
      'Disney Moana',
      'Disney Princess',
      'Disney Zombies',
      'Disney and Pixar',
    ],
  },
  { letter: 'F', links: ['Fisher-Price', 'Wooden Toys'] },
  { letter: 'H', links: ['Hot Wheels', 'Harry Potter'] },
];

// Simulamos una cuadrícula llena repitiendo los elementos para visualización
const gridItems = [...tematicas, ...tematicas, ...tematicas];
---

<Layout title="Todas las Temáticas | Tu Tienda">
  <main class="w-full bg-[#fcfcfc] min-h-screen pt-8 pb-16">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 md:px-8 flex flex-col md:flex-row items-start gap-8 lg:gap-12 relative">
      <!-- Columna Izquierda: Índice Alfabético (Filtro) -->
      <aside class="w-full md:w-56 lg:w-64 shrink-0 md:sticky md:top-24 md:h-[calc(100vh-8rem)] md:overflow-y-auto [&::-webkit-scrollbar]:w-1.5 [&::-webkit-scrollbar-thumb]:bg-gray-200 [&::-webkit-scrollbar-thumb]:rounded-full pr-2">
        <div class="bg-white md:bg-transparent rounded-2xl shadow-sm md:shadow-none p-5 md:p-0 border border-gray-100 md:border-none">
          <div class="flex items-center justify-between mb-4 md:mb-6 border-b border-gray-200 pb-3">
            <h1 class="text-xl font-extrabold text-gray-800 font-['Quicksand'] tracking-tight">
              Brands A - Z
            </h1>
            <svg
              class="w-5 h-5 text-gray-400 md:hidden"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"
              />
            </svg>
          </div>

          <!-- Botón para limpiar filtros y ver todas -->
          <button
            class="filter-btn w-full text-left text-sm font-bold text-[#ff4b8b] hover:text-[#e6206b] mb-6 flex items-center gap-2 transition-colors"
            data-filter="all"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2.5"
              stroke="currentColor"
              class="w-4 h-4"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"
              />
            </svg>
            Mostrar todas
          </button>

          <!-- Lista A-Z Funcional -->
          <div class="space-y-7 md:pr-4">
            {brandsIndex.map((group) => (
              <div class="group/letter">
                <h2 class="text-sm font-extrabold text-gray-900 mb-2.5 font-['Quicksand']">
                  {group.letter}
                </h2>
                <ul class="space-y-2">
                  {group.links.map((link) => (
                    <li>
                      <button
                        class="filter-btn text-left text-[13px] font-medium text-gray-500 hover:text-[#ff4b8b] hover:translate-x-1 transition-all duration-200 font-['Quicksand'] w-full"
                        data-filter={link.toLowerCase().replace(/\s+/g, '-')}
                      >
                        {link}
                      </button>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </aside>

      <!-- Columna Derecha: Cuadrícula de Temáticas -->
      <section class="flex-1 w-full bg-white rounded-3xl shadow-sm border border-gray-100 p-6 sm:p-8 lg:p-10 min-h-[500px]">
        <!-- Encabezado de la cuadrícula -->
        <div class="flex items-center justify-between mb-8 pb-4 border-b border-pink-50">
          <h2 id="grid-title" class="text-2xl font-extrabold text-[#ff4b8b] font-['Quicksand']">
            Todas las Temáticas
          </h2>
          <span
            id="results-count"
            class="text-sm font-bold text-gray-400 font-['Quicksand'] bg-gray-50 px-3 py-1 rounded-full transition-all"
          >
            {gridItems.length} Resultados
          </span>
        </div>

        <!-- Grid Responsivo (Cada item lleva data-slug para el filtro) -->
        <div
          id="tematicas-grid"
          class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-x-4 gap-y-10 sm:gap-y-12"
        >
          {gridItems.map((item) => (
            <a
              href={`/tematicas/${item.slug}`}
              data-slug={item.slug}
              class="theme-card flex flex-col items-center gap-3 group hover:-translate-y-1.5 transition-transform duration-300 animate-fade-in"
            >
              <div class="w-[90px] h-[90px] sm:w-[110px] sm:h-[110px] rounded-full bg-gradient-to-br from-pink-50 to-white border border-pink-100 group-hover:border-pink-300 shadow-sm group-hover:shadow-[0_8px_20px_-6px_rgba(255,75,139,0.4)] transition-all duration-300 flex items-center justify-center p-1.5 sm:p-2 shrink-0">
                <img
                  src={item.imagen}
                  alt={item.nombre}
                  class="w-full h-full object-contain rounded-full group-hover:scale-110 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
              <span class="text-xs sm:text-[13px] font-bold text-gray-700 font-['Quicksand'] text-center leading-tight group-hover:text-[#ff4b8b] transition-colors px-1 w-full truncate">
                {item.nombre}
              </span>
            </a>
          ))}
        </div>

        <!-- Mensaje de "No hay resultados" (Oculto por defecto) -->
        <div id="no-results" class="hidden flex-col items-center justify-center py-16 text-center">
          <svg
            class="w-16 h-16 text-gray-300 mb-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"
            />
          </svg>
          <h3 class="text-lg font-bold text-gray-700 font-['Quicksand'] mb-1">
            No encontramos temáticas
          </h3>
          <p class="text-sm text-gray-500 font-['Quicksand']">
            Intenta seleccionando otra categoría o muestra todas.
          </p>
        </div>
      </section>
    </div>
  </main>
</Layout>

<style>
  /* Animación suave al filtrar elementos */
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  .animate-fade-in {
    animation: fadeIn 0.4s ease-out forwards;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const themeCards = document.querySelectorAll('.theme-card');
    const resultsCount = document.getElementById('results-count');
    const gridTitle = document.getElementById('grid-title');
    const noResults = document.getElementById('no-results');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filterValue = btn.getAttribute('data-filter');
        const filterName = btn.textContent?.trim();

        // 1. Actualizar estilos visuales de los botones en el menú lateral
        filterBtns.forEach((b) => {
          b.classList.remove('text-[#ff4b8b]', 'font-extrabold', 'translate-x-1');
          b.classList.add('text-gray-500', 'font-medium');
        });
        // Si no es el botón "Mostrar todas", resaltar el seleccionado
        if (filterValue !== 'all') {
          btn.classList.remove('text-gray-500', 'font-medium');
          btn.classList.add('text-[#ff4b8b]', 'font-extrabold', 'translate-x-1');
        }

        // 2. Filtrar las tarjetas de la cuadrícula
        let count = 0;
        themeCards.forEach((card) => {
          const cardElement = card as HTMLElement;
          const slug = cardElement.getAttribute('data-slug') || '';

          // Reiniciamos la animación para que se vea fluida al cambiar de filtro
          cardElement.style.animation = 'none';
          cardElement.offsetHeight; // trigger reflow
          cardElement.style.animation = '';

          // Lógica: Muestra si es 'all' o si el slug de la tarjeta contiene el valor del filtro
          if (filterValue === 'all' || slug.includes(filterValue!)) {
            cardElement.style.display = 'flex';
            count++;
          } else {
            cardElement.style.display = 'none';
          }
        });

        // 3. Actualizar textos de UI (Contador y Título)
        if (resultsCount) {
          resultsCount.textContent = `${count} Resultados`;
          // Pequeño efecto visual en el contador
          resultsCount.classList.add('scale-110', 'bg-pink-100', 'text-[#ff4b8b]');
          setTimeout(
            () => resultsCount.classList.remove('scale-110', 'bg-pink-100', 'text-[#ff4b8b]'),
            300
          );
        }

        if (gridTitle) {
          gridTitle.textContent =
            filterValue === 'all' ? 'Todas las Temáticas' : `Temática: ${filterName}`;
        }

        // 4. Mostrar estado "Sin resultados" si el contador es 0
        if (noResults) {
          if (count === 0) {
            noResults.classList.remove('hidden');
            noResults.classList.add('flex');
          } else {
            noResults.classList.add('hidden');
            noResults.classList.remove('flex');
          }
        }
      });
    });
  });
</script>
