---
// src/layouts/MainLayout.astro
import Footer from '../components/Footer.astro';
import Header from '../components/header/Header.astro';
import MainNav from '../components/mainNav/MainNav.astro';
import TopBar from '../components/TopBar.astro';
import '../styles/global.css'; // Tu archivo donde configuras Tailwind CSS

// Definimos las propiedades que este layout puede recibir
interface Props {
  title: string;
  description?: string;
}

// Extraemos las propiedades, asignando valores por defecto
const {
  title = 'Tienda de Archivos Digitales',
  description = 'Descarga los mejores archivos, vectores y diseños para tus proyectos creativos.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Etiquetas SEO dinámicas -->
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Importación de fuentes (Ejemplo: Quicksand o Poppins encajan bien con el diseño que mostraste) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Quicksand:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </head>

  {/* Flexbox en el body asegura que el footer siempre se quede abajo si la página tiene poco contenido */}
  <body class="min-h-screen flex flex-col font-['Quicksand'] bg-white text-gray-800">
    <TopBar />
    <Header client:load />
    <MainNav client:load />
    <!-- Contenedor principal donde se inyectará el contenido de las páginas (como index.astro) -->
    <main class="grow w-full">
      <slot />
    </main>
    <Footer />
  </body>
</html>
